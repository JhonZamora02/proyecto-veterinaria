<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="Factura_OrdenServicio" language="java" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="3144df19-8943-4194-8527-36c3b9b990d2">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Orden_Servicio"/>
	<parameter name="idOrden" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    os.os_id,
    os.os_fecha,
    os.os_mas_propietario AS propietario,
    os.os_valor_total,
    os.os_abono,
    os.os_saldo,
    os.os_estado,
    
    m.mas_nombre AS mascota,
    m.mas_edad AS edad,
    m.mas_sexo AS sexo,
    esp.esp_descripcion AS especie,
    raza.raza_descripcion AS raza,
    
    v.vet_nombre AS veterinario,
    v.vet_veterinaria AS clinica,
    
    d.dos_id,
    d.dos_exa_id,
    COALESCE(e.exa_descripcion, '') AS examen,
    d.dos_exa_valor AS valor,
    d.dos_exa_cantidad AS cantidad,
    d.dos_exa_observaciones AS observaciones

FROM orden_servicio os
INNER JOIN mascota m         ON m.mas_id   = os.os_mas_id
INNER JOIN raza raza         ON raza.raza_id = m.raza_id
INNER JOIN especie esp       ON esp.esp_id = raza.esp_id
INNER JOIN veterinario v     ON v.vet_id   = os.os_vet_id
INNER JOIN orden_servicio_detalle d ON d.dos_os_id = os.os_id
LEFT  JOIN examen e          ON e.exa_id   = d.dos_exa_id 

WHERE os.os_id = $P{idOrden}
ORDER BY d.dos_id ASC]]></query>
