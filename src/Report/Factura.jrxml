<jasperReport name="Factura" language="java" pageWidth="612" pageHeight="792" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8d975d8c-4b8d-4412-827a-67c7b19e90cc">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<parameter name="os_id" class="java.lang.Integer"/>
	<query language="SQL"><![CDATA[SELECT 
    os.os_id,
    os.os_fecha,
    v.vet_nombre AS veterinario,
    v.vet_veterinaria AS veterinaria,
    m.mas_nombre AS mascota,
    m.mas_propietario AS propietario,
    os.os_valor_total AS total,
    os.os_abono AS abono,
    os.os_saldo AS saldo,
    os.os_observaciones,
    e.exa_descripcion AS examen,
    osd.dos_exa_valor AS valor_examen,
    osd.dos_exa_cantidad AS cantidad,
    (osd.dos_exa_valor * osd.dos_exa_cantidad) AS subtotal
FROM orden_servicio os
INNER JOIN veterinario v ON os.os_vet_id = v.vet_id
INNER JOIN mascota m ON os.os_mas_id = m.mas_id
LEFT JOIN orden_servicio_detalle osd ON os.os_id = osd.dos_os_id
LEFT JOIN examen e ON osd.dos_exa_id = e.exa_id
WHERE os.os_id = $P{os_id}
ORDER BY osd.dos_id]]></query>
